default_platform(:ios)

platform :ios do
  desc "Build the app and upload it to TestFlight"
  lane :beta do
    # Authenticate with the App Store Connect API key (.p8, base64-encoded in CI secret).
    # The same key drives both automatic provisioning (-allowProvisioningUpdates) and the upload.
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    # TestFlight requires a unique, monotonic build number per upload.
    # CI passes the GitHub run number; local runs fall back to a timestamp.
    build_number = ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")

    build_app(
      project: "iosApp.xcodeproj",
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      api_key: api_key,
      # -allowProvisioningUpdates lets Xcode create/refresh the distribution cert and
      # the App Store provisioning profile (incl. Push + App Groups) automatically in CI.
      xcargs: "-allowProvisioningUpdates CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        signingStyle: "automatic"
      },
      output_directory: "build",
      output_name: "HanmaumDnApp.ipa",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
