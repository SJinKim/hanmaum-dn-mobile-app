require "base64"

default_platform(:ios)

platform :ios do
  desc "Build the app and upload it to TestFlight"
  lane :beta do
    key_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_ID")
    issuer_id = ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID")

    # Decode the base64 .p8 key to a file. xcodebuild needs the key on disk to
    # authenticate to App Store Connect during the archive (for
    # -allowProvisioningUpdates). gym/build_app does NOT forward the
    # lane-context API key to the archive command, so we pass it explicitly via
    # xcargs below.
    key_path = File.expand_path("AuthKey_#{key_id}.p8")
    File.write(key_path, Base64.decode64(ENV.fetch("APP_STORE_CONNECT_API_KEY_BASE64")))

    # Same key drives the TestFlight upload below.
    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false
    )

    # TestFlight requires a unique, monotonic build number per upload.
    # CI passes the GitHub run number; local runs fall back to a timestamp.
    build_number = ENV["BUILD_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")

    build_app(
      project: "iosApp.xcodeproj",
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      # -allowProvisioningUpdates lets Xcode create/refresh the distribution cert
      # and App Store provisioning profile automatically in CI; the
      # -authenticationKey* args give xcodebuild the App Store Connect API key it
      # needs to do that (gym does not pass these to the archive command for us).
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath", key_path,
        "-authenticationKeyID", key_id,
        "-authenticationKeyIssuerID", issuer_id,
        "CURRENT_PROJECT_VERSION=#{build_number}"
      ].join(" "),
      export_options: {
        signingStyle: "automatic"
      },
      output_directory: "build",
      output_name: "HanmaumDnApp.ipa",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
